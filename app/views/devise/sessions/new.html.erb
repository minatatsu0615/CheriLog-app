<header class="top-header">
  <div class="top-header__logo">
    CheriLog <span>♥</span>
  </div>

  <div class="top-header__actions">
    <%= link_to "新規登録",
                new_user_registration_path,
                class: "signup-button" %>
  </div>
</header>

<main class="top-main">
  <section class="top-introduction">
    <div class="top-catchphrase">
      ＼ 好きが集まる、わたしの記録帳 ／
    </div>

    <h1 class="top-title">
      CheriLog <span>♡</span>
    </h1>

    <p class="top-description">
      日常の「好き」や体験を、<br>
      自分のために残して振り返る<br>
      ライフログサービス
    </p>
  </section>

  <section class="signin-card">
    <h2>サインイン</h2>

    <%= form_for(resource,
                 as: resource_name,
                 url: session_path(resource_name),
                 html: { class: "signin-form" }) do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          placeholder: "example@email.com" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password,
                             autocomplete: "current-password",
                             placeholder: "パスワードを入力" %>
      </div>

      <%= f.submit "サインイン", class: "signin-button" %>
    <% end %>
  </section>
</main>