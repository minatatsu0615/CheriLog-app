<header class="top-header">
  <div class="top-header__logo">
    CheriLog <span>♥</span>
  </div>

  <div class="top-header__actions">
    <%= link_to "戻る",
                new_user_session_path,
                class: "signup-button" %>
  </div>
</header>

<main class="top-main">
  <section class="top-introduction">
    <div class="top-catchphrase">
      ＼ 好きが集まる、わたしの記録帳 ／
    </div>

    <h1 class="top-title">
      CheriLog <span>♡</span>
    </h1>

    <p class="top-description">
      日常の「好き」や体験を、<br>
      自分のために残して振り返る<br>
      ライフログサービス
    </p>
  </section>

  <section class="signin-card">
    <h2>新規登録</h2>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { class: "signin-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name,
                         autofocus: true,
                         autocomplete: "name",
                         placeholder: "名前を入力" %>
      </div>

      <div class="form-group">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email,
                          autocomplete: "email",
                          placeholder: "example@email.com" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password" %>
        <% if @minimum_password_length %>
          <small><%= @minimum_password_length %>文字以上で入力してください</small>
        <% end %>
        <%= f.password_field :password,
                             autocomplete: "new-password",
                             placeholder: "パスワードを入力" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Password確認" %>
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password",
                             placeholder: "パスワードを再入力" %>
      </div>

      <%= f.submit "新規登録", class: "signin-button" %>
    <% end %>
  </section>
</main>