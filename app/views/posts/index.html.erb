<h1>投稿一覧</h1>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <div>
      <% if post.image.attached? %>
        <%= image_tag post.image, width: 300 %>
      <% end %>

      <h2><%= post.title %></h2>

      <p>
        カテゴリー：
        <%= post.category.name %>
      </p>

      <% if post.favorite_rating.present? %>
        <p>
          お気に入り度：
          <%= "★" * post.favorite_rating %>
        </p>
      <% end %>

      <% if post.emotion.present? %>
        <p>
          感情：
          <%= post.emotion.humanize %>
        </p>
      <% end %>

      <%= link_to "詳細を見る", post_path(post) %>

      <hr>
    </div>
  <% end %>
<% else %>
  <p>まだ投稿がありません。</p>
<% end %>