<div class="posts-page">
  <div class="posts-container">
    <div class="posts-header">
      <div>
        <p class="posts-header__label">MY MEMORIES</p>
        <h1 class="posts-header__title">投稿一覧</h1>
        <p class="posts-header__description">
          あなたの「好き」や心が動いた瞬間を振り返ろう
        </p>
      </div>

      <%= link_to "＋ 新規投稿", new_post_path, class: "primary-button" %>
    </div>

    <div class="category-filter">
      <%= link_to "すべて",
                  posts_path,
                  class: "category-filter__button #{'is-active' if params[:category_id].blank?}" %>

      <% @categories.each do |category| %>
        <%= link_to category.name,
                    posts_path(category_id: category.id),
                    class: "category-filter__button #{'is-active' if params[:category_id].to_s == category.id.to_s}" %>
      <% end %>
    </div>

    <% if @posts.any? %>
      <div class="posts-grid">
        <% @posts.each do |post| %>
          <article class="post-card">
            <div class="post-card__image">
              <% if post.image.attached? %>
                <%= image_tag post.image %>
              <% else %>
                <div class="post-card__placeholder">
                  No Image
                </div>
              <% end %>
            </div>

            <div class="post-card__content">
              <span class="post-card__category">
                <%= post.category.name %>
              </span>

              <h2 class="post-card__title">
                <%= post.title.presence || "タイトルなし" %>
              </h2>

              <div class="post-card__details">
                <% if post.favorite_rating.present? %>
                  <p class="post-card__rating">
                    <span>お気に入り</span>
                    <span class="post-card__stars">
                      <%= "★" * post.favorite_rating %>
                    </span>
                  </p>
                <% end %>

                <% if post.emotion.present? %>
                  <p class="post-card__emotion">
                    <span>気持ち</span>
                    <span><%= post.emotion.humanize %></span>
                  </p>
                <% end %>
              </div>

              <%= link_to "詳細を見る →",
                          post_path(post),
                          class: "post-card__link" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="posts-empty">
        <p>まだ記録がありません。</p>
        <p>最初の「好き」を残してみましょう。</p>

        <%= link_to "最初の記録を作る",
                    new_post_path,
                    class: "primary-button" %>
      </div>
    <% end %>
  </div>
</div>