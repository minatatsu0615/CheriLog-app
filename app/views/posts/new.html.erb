<h1>新しい記録を追加</h1>

<% if @post.errors.any? %>
  <div>
    <p>入力内容を確認してください</p>

    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post do |f| %>
  <div>
    <%= f.label :image, "写真" %>
    <%= f.file_field :image, accept: "image/*" %>
  </div>

  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :category_id, "カテゴリー" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, prompt: "カテゴリーを選択" %>
  </div>

  <div>
    <%= f.label :body, "コメント（任意）" %>
    <%= f.text_area :body %>
  </div>

  <div>
    <%= f.label :favorite_rating, "お気に入り度（任意）" %>
    <%= f.select :favorite_rating,
                 (1..5).map { |number| ["★#{number}", number] },
                 { include_blank: "選択しない" } %>
  </div>

  <div>
    <%= f.label :emotion, "感情（任意）" %>
    <%= f.select :emotion,
                 Post.emotions.keys.map { |emotion| [emotion.humanize, emotion] },
                 { include_blank: "選択しない" } %>
  </div>

  <div>
    <%= f.submit "記録する" %>
  </div>
<% end %>
